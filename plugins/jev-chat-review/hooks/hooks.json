{
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/hooks/monitor-event.mjs\"", "timeout": 2, "async": true }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/hooks/monitor-event.mjs\"", "timeout": 2, "async": true }] }],
    "PostToolUse": [{ "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/hooks/monitor-event.mjs\"", "timeout": 2, "async": true }] }],
    "SessionEnd": [{ "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/hooks/monitor-event.mjs\"", "timeout": 2, "async": true }] }],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/monitor-event.mjs\"",
            "timeout": 2,
            "async": true
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/review-stop.mjs\"",
            "timeout": 20,
            "statusMessage": "Jev prüft den abgeschlossenen Codex-Lauf"
          }
        ]
      }
    ]
  }
}
