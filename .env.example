# Required for check/mcp. The mock provider is synthetic and never calls an API.
MINDRAILS_PROVIDER=mock
TYPESAFE_API_KEY=
# Optional alternative for MINDRAILS_PROVIDER=jev:
# MINDRAILS_JEV_ROUTE=vercel-ai-gateway
# AI_GATEWAY_API_KEY=
MINDRAILS_MAX_CALLS=100
MINDRAILS_MAX_INPUT_BYTES=320000
MINDRAILS_TIMEOUT_MS=5000
